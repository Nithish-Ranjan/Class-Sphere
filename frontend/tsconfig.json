{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  "exclude": [
    "src/pages/Student/StudentDashboard.tsx",
    "src/pages/Student/MyActivity.tsx",
    "src/pages/Student/SubjectAttendance.tsx",
    "src/pages/Student/ActivityComparison.tsx",
    "src/pages/Student/AttendanceHistory.tsx",
    "src/pages/Faculty/*View.tsx",
    "src/pages/Faculty/FacultyDashboard.tsx",
    "src/pages/Faculty/LiveClassroom.tsx",
    "src/pages/Faculty/SafetyCenter.tsx",
    "src/pages/HOD/AcademicOversight.tsx",
    "src/pages/HOD/Administration.tsx",
    "src/pages/HOD/ClassIntelligence.tsx",
    "src/pages/HOD/SafetyManagement.tsx",
    "src/pages/Shared/AccountView.tsx",
    "src/pages/Shared/NotificationsView.tsx"
  ],
  "references": [{ "path": "./tsconfig.node.json" }]
}
