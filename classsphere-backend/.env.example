# ==============================================================================
# CLASSSPHERE BACKEND ENVIRONMENT CONFIGURATION (EXAMPLE)
# ==============================================================================

# Database Connection (AsyncPG for Application Runtime)
POSTGRES_SERVER=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=classsphere
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password

# Dedicated Database Roles
# Migration Role (DDL superuser with BYPASSRLS)
MIGRATOR_USER=classsphere_migrator
MIGRATOR_PASSWORD=migrator_secure_pass_2026

# Application Runtime Role (DML only, NO BYPASSRLS, strictly subject to RLS)
APP_DB_USER=classsphere_app
APP_DB_PASSWORD=app_secure_pass_2026

# Connection URLs
DATABASE_URL=postgresql+asyncpg://classsphere_app:app_secure_pass_2026@127.0.0.1:5433/classsphere
MIGRATION_DATABASE_URL=postgresql+psycopg://classsphere_migrator:migrator_secure_pass_2026@127.0.0.1:5433/classsphere
ADMIN_DATABASE_URL=postgresql+psycopg://postgres:postgres_dev_password@127.0.0.1:5433/classsphere

# Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Environment Mode
ENVIRONMENT=development
LOG_LEVEL=INFO

# API & Security
API_V1_PREFIX=/api/v1
PROJECT_NAME="ClassSphere Core API"

# JWT RS256 Configuration (Generate RSA keypair or set PEM strings)
JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY_PATH=.keys/jwt_rsa_private.pem
JWT_PUBLIC_KEY_PATH=.keys/jwt_rsa_public.pem
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER=classsphere-auth
JWT_AUDIENCE=classsphere-api
